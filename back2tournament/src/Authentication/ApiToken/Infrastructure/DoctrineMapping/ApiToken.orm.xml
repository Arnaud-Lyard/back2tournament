<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Authentication\ApiToken\Domain\Entity\ApiToken" table="api_token" repository-class="App\Authentication\ApiToken\Infrastructure\Repository\ApiTokenRepository">
        <unique-constraints>
            <unique-constraint columns="name" name="uniq_api_token_name" />
            <unique-constraint columns="token_hash" name="uniq_api_token_hash" />
        </unique-constraints>

        <id name="id" type="guid" column="id" length="36" />

        <field name="name" type="string" column="name" length="40" />
        <field name="tokenHash" type="string" column="token_hash" length="64" />

        <field name="createdAt" type="datetime_immutable" column="created_at" />
        <field name="expiresAt" type="datetime_immutable" column="expires_at" nullable="true" />
        <field name="lastUsedAt" type="datetime_immutable" column="last_used_at" nullable="true" />
    </entity>

</doctrine-mapping>
