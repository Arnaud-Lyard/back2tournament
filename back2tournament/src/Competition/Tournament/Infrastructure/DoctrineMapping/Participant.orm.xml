<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Competition\Tournament\Domain\Entity\Participant" table="tournament_participant" repository-class="App\Competition\Tournament\Infrastructure\Repository\ParticipantRepository">
        <unique-constraints>
            <unique-constraint columns="tournament,competitor" name="uniq_tournament_participant" />
        </unique-constraints>

        <id name="id" type="guid" column="id" length="36" />

        <field name="tournament" type="guid" column="tournament" length="36" />
        <field name="competitor" type="guid" column="competitor" length="36" />
        <field name="seed" type="integer" column="seed" />

        <field name="createdAt" type="datetime_immutable" column="created_at" />
        <field name="updatedAt" type="datetime_immutable" column="updated_at" />
    </entity>

</doctrine-mapping>
