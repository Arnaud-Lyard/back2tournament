<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Competition\Tournament\Domain\Entity\Matchup" table="tournament_matchup" repository-class="App\Competition\Tournament\Infrastructure\Repository\MatchupRepository">
        <unique-constraints>
            <unique-constraint columns="tournament,round,position" name="uniq_tournament_matchup" />
        </unique-constraints>

        <id name="id" type="guid" column="id" length="36" />

        <field name="tournament" type="guid" column="tournament" length="36" />
        <field name="round" type="integer" column="round" />
        <field name="position" type="integer" column="position" />

        <field name="competitorOne" type="guid" column="competitor_one" length="36" nullable="true" />
        <field name="competitorTwo" type="guid" column="competitor_two" length="36" nullable="true" />
        <field name="fight" type="guid" column="fight" length="36" nullable="true" />
        <field name="winner" type="guid" column="winner" length="36" nullable="true" />

        <field name="createdAt" type="datetime_immutable" column="created_at" />
        <field name="updatedAt" type="datetime_immutable" column="updated_at" />
    </entity>

</doctrine-mapping>
