<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Competition\Ranking\Domain\Entity\RatingChange" table="rating_change" repository-class="App\Competition\Ranking\Infrastructure\Repository\RatingChangeRepository">
        <unique-constraints>
            <unique-constraint columns="rating,fight" name="uniq_rating_change_fight" />
        </unique-constraints>
        <indexes>
            <index columns="fight" name="idx_rating_change_fight" />
        </indexes>

        <id name="id" type="guid" column="id" length="36" />

        <field name="rating" type="guid" column="rating" length="36" />
        <field name="fight" type="guid" column="fight" length="36" />
        <field name="before" type="integer" column="before_value" />
        <field name="after" type="integer" column="after_value" />

        <field name="createdAt" type="datetime_immutable" column="created_at" />
    </entity>

</doctrine-mapping>
