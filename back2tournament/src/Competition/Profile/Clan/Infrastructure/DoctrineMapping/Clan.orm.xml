<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Competition\Profile\Clan\Domain\Entity\Clan" table="clan" repository-class="App\Competition\Profile\Clan\Infrastructure\Repository\ClanRepository">
        <unique-constraints>
            <unique-constraint columns="game,tag" name="uniq_clan_game_tag" />
        </unique-constraints>

        <id name="id" type="guid" column="id" length="36" />

        <field name="name" column="name" length="50" />
        <field name="tag" column="tag" length="5" />

        <field name="game" type="guid" column="game" length="36" />
        <field name="leader" type="guid" column="leader" length="36" />

        <field name="createdAt" type="datetime_immutable" column="created_at" />
        <field name="updatedAt" type="datetime_immutable" column="updated_at" />
    </entity>

</doctrine-mapping>
