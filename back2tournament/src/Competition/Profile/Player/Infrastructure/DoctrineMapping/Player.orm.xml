<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Competition\Profile\Player\Domain\Entity\Player" table="player" repository-class="App\Competition\Profile\Player\Infrastructure\Repository\PlayerRepository">
        <unique-constraints>
            <unique-constraint columns="`user`,game" name="uniq_player_user_game" />
        </unique-constraints>

        <id name="id" type="guid" column="id" length="36" />

        <field name="battletag" column="battletag" length="255" />

        <field name="createdAt" type="datetime_immutable" column="created_at"  />
        <field name="updatedAt" type="datetime_immutable" column="updated_at" />

        <field name="user" type="guid" column="`user`" length="36" />
        <field name="game" type="guid" column="game" length="36" />
        <field name="anonymizedAt" type="datetime_immutable" column="anonymized_at" nullable="true" />
    </entity>

</doctrine-mapping>
