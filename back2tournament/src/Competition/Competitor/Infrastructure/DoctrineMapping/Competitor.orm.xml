<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Competition\Competitor\Domain\Entity\Competitor" table="competitor" repository-class="App\Competition\Competitor\Infrastructure\Repository\CompetitorRepository">
        <unique-constraints>
            <unique-constraint columns="type,reference" name="uniq_competitor_reference" />
        </unique-constraints>

        <id name="id" type="guid" column="id" length="36" />

        <field name="type" type="string" column="type" length="16" enum-type="App\Competition\Competitor\Domain\Enum\CompetitorType" />
        <field name="reference" type="guid" column="reference" length="36" />

        <field name="createdAt" type="datetime_immutable" column="created_at" />
        <field name="updatedAt" type="datetime_immutable" column="updated_at" />
    </entity>

</doctrine-mapping>
