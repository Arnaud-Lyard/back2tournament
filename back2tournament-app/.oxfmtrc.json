{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "endOfLine": "lf",
  "sortPackageJson": true,
  "sortTailwindcss": {
    "stylesheet": "src/app/globals.css",
    "functions": ["cn", "cva", "clsx"]
  },
  "ignorePatterns": [
    ".next",
    "node_modules",
    "package-lock.json",
    "public",
    ".agents"
  ]
}
