# Symfony backend base URL, used server-side by the auth proxy route handlers
# and every resource fetch. No default — the app fails fast if this is unset.
# Symfony Docker's https://localhost uses a self-signed cert from its own
# local CA, which Node rejects by default. Run `npm run certs:sync` once
# (requires the backend's caddy_data volume to exist) to pull that CA into
# .certs/, which `npm run dev`/`start` then trust via NODE_EXTRA_CA_CERTS.
SYMFONY_API_URL=https://localhost

# Only read by `npm run api:types` (scripts/generate-api-types.mjs), never by
# the running app. Defaults to the local Symfony dev doc endpoint.
OPENAPI_SCHEMA_URL=https://localhost/api/doc.json

# Canonical site origin — used for metadata, sitemap, manifest, OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# development | staging | production — drives Sentry's `environment` tag
# (Coolify has no VERCEL_ENV equivalent).
NEXT_PUBLIC_APP_ENV=development

# Name of the httpOnly cookie holding the JWT. Optional, defaults to b2t_session.
AUTH_COOKIE_NAME=b2t_session

# Sentry (all optional — Sentry no-ops entirely if the DSN is unset).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
