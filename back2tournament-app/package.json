{
  "name": "back2tournament-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=./.certs/caddy-local-ca.pem next dev",
    "build": "next build",
    "start": "NODE_EXTRA_CA_CERTS=./.certs/caddy-local-ca.pem next start",
    "certs:sync": "bash scripts/sync-caddy-ca.sh",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm run knip && npm run test",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "e2e": "playwright test --config config/playwright.config.ts",
    "e2e:ui": "playwright test --config config/playwright.config.ts --ui",
    "playwright:install": "playwright install chromium firefox webkit",
    "playwright:install:deps": "playwright install-deps",
    "api:generate": "NODE_EXTRA_CA_CERTS=./.certs/caddy-local-ca.pem orval --config orval.config.ts",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@sentry/nextjs": "^10.74.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.45.0",
    "next": "16.3.4",
    "next-intl": "^4.14.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "lefthook": "^2.1.12",
    "orval": "^8.39.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
