{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,template,default,sitemap,robots,manifest,route,global-error}.{ts,tsx}",
    "src/libs/query-client.ts",
    "src/libs/api/client.ts",
    "src/features/auth/hooks/*.tsx",
    "src/features/auth/server/*.ts",
    "src/features/auth/rbac/*.ts",
    "src/features/auth/schemas/*.ts",
    "src/features/i18n/*.ts",
    "src/features/site/config.ts",
    "scripts/*.mjs",
    "tests/test-utils.tsx"
  ],
  "project": [
    "src/**/*.{js,jsx,ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "e2e/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": ["tw-animate-css", "tailwindcss", "shadcn"],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/components/ui/**": ["exports", "types"]
  }
}
